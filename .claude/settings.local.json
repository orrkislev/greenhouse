{
  "permissions": {
    "allow": [
      "Bash(xargs -I {} bash -c \"echo '=== {} ===' && head -30 {}\")",
      "Bash(grep -v \"^\\\\.$\")",
      "Bash(grep -v \"^\\\\.\\\\.$\")",
      "Bash(npm ls *)",
      "Bash(grep -E \"\\\\.\\(ts|tsx|sql\\)$\")",
      "Bash(supabase status *)",
      "Bash(npx supabase *)",
      "Bash(npx next lint *)",
      "Bash(node_modules/.bin/next lint *)",
      "Bash(node_modules/.bin/eslint *)"
    ],

    "deny": [
      "Read(./.env.local)"
    ] 
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "supabase"
  ]
}
